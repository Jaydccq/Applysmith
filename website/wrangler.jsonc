// The Worker's name and the account are given at the command line
// (--name), never here; see README.md, Publishing.
{
  "compatibility_date": "2026-07-17",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/assets/*.mp4"]
  }
}
