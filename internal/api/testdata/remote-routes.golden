# The routes a remote device may call: every route the table marks "remote: allowed".
# TestRemoteGoldenMatchesTheRouteTable fails when the table and this list differ, so
# widening the remote surface is an explicit change to this file and to the
# remote-access specification. The lane screenshot route also needs
# remote_access.allow_screenshots.
DELETE /api/agent/approvals/{id}
GET /api/applications/lookup
GET /api/apply/list
GET /api/board/events
GET /api/browser/lanes/{lane}/tabs/{tabId}/screenshot
GET /api/candidacies
GET /api/candidacies/{id}
GET /api/chat/sessions/{id}/events
GET /api/health
GET /api/needs-you
GET /api/notifications/events
GET /api/remote/me
GET /api/reports
GET /api/reports/{number}
GET /api/runs
GET /api/runs/summary
GET /api/runs/{id}
GET /api/runs/{id}/events
GET /api/schedules
GET /pair
GET /{path...}
POST /api/agent/confirmations/{id}/approve
POST /api/chat/sessions/{id}/messages
POST /api/notifications/{announcementId}/ack
POST /api/remote/pair/claim
POST /api/runs/{id}/ack
POST /api/runs/{id}/cancel
POST /api/runs/{id}/seen
